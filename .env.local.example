# Google AI Studio - free tier covers hackathon usage
# Get key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude - used as adversarial reviewer
# Get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Bright Data Web Unlocker + SERP API — for fetchVendorStatus, searchPublicPostmortems,
# fetchGithubRecentCommits tools. Free tier covers 5,000 requests/month.
# Sign up: https://brightdata.com/cp/api_settings
# Without these keys, those tools gracefully fall back to curated mock data — demo still works.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=web_unlocker1
BRIGHT_DATA_SERP_ZONE=serp_api1
